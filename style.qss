/*
 * 整体 UI 优化：更柔和的背景和一致的字体。
 * 调整了字体大小，使其更现代。
 */
QWidget {
    /* 窗口背景：使用接近纯白的浅灰色，更专业和“透气” */
    background-color: #f7f9fa;
    font-family: "Microsoft YaHei", "Segoe UI", SimSun; /* 增加备用字体 */
    font-size: 8pt; /* 稍稍增大字体，提高可读性 */
    color: #333333; /* 默认文字颜色改为深灰色，更柔和 */
}

/*
QPushButton#pushButton_Connect {
    background-color: #28a745;
    border-color: #28a745;
}
*/

/*
 * QPushButton 优化：
 * - 引入更专业的蓝色。
 * - 添加微妙的阴影 (box-shadow 的 QSS 等价实现)。
 * - 更精细的圆角。
 */
QPushButton {
    /* 按钮基础色：更具科技感和专业度的蓝色#5AA7F9 */
    background-color: #007bff;
    color: white;
    border: 2px solid #007bff; /* 保持边框与背景色一致，增加清晰度 */
    padding: 3px 5px; /* 增加内边距，使按钮更饱满 */
    border-radius: 4px; /* 略微增大的圆角，更现代 */
    /* 模拟阴影：在 Windows/macOS 风格中，通常使用 border/margin 的组合，
       但 QSS 更推荐使用 QWidget::hover/pressed 的微小变化或直接的背景色对比 */
}

/* 鼠标悬停时的效果：稍微变亮，提供精致的反馈 */
QPushButton:hover {
    background-color: #0069d9; /* 略微变深的蓝色 */
    border-color: #0062cc;
}

/* 按下时的效果：深度沉浸感，常用于“激活”或“按下”状态 */
QPushButton:pressed {
    background-color: #0056b3; /* 明显变深的蓝色 */
    border-color: #004d9c;
    padding-top: 11px; /* 模拟“下沉”效果 */
    padding-bottom: 9px;
}

/* 禁用状态（重要：提升专业感） */
QPushButton:disabled {
    background-color: #cccccc; /* 浅灰色背景 */
    color: #666666; /* 深灰色文字 */
    border: 1px solid #cccccc;
}

/* QToolButton 优化：通常用于工具栏，更注重图标和方形/圆形，移除文字内边距 */
QToolButton {
    background-color: transparent; /* 通常工具按钮背景是透明的 */
    color: #007bff; /* 图标或文字使用主题色 */
    border: none;
    padding: 8px;
    border-radius: 4px; /* 小圆角 */
}

QToolButton:hover {
    background-color: #e6f0ff; /* 悬停时显示柔和的背景色 */
    color: #0056b3;
}

QToolButton:pressed {
    background-color: #cce0ff;
}

