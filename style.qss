/* ---------------------------------------------------------------------- */
/* 1. 输入框 (QLineEdit) 样式 */
/* ---------------------------------------------------------------------- */
QLineEdit {
    /* 背景色：浅白，与窗口背景有区分 */
    background-color: white;
    /* 边框：柔和的浅灰色边框 */
    border: 1px solid #ced4da;
    /* 圆角：保持与按钮一致的圆角设计风格 */
    border-radius: 4px; /* 输入框通常比按钮圆角小一点 */
    /* 内边距：提供输入空间 */
    padding: 3px 5px;
    /* 字体颜色 */
    color: #333333;
}

/* 获得焦点时：边框高亮为主题色，提高用户感知 */
QLineEdit:focus {
    border-color: #007bff;
    /* 可选：增加一个微弱的外部“光晕”效果 */
    /* qproperty-focusPolicy: 'StrongFocus'; 这不是 QSS 属性，但常用于此目的 */
}

/* ---------------------------------------------------------------------- */
/* 2. 复选框 (QCheckBox) 样式 */
/* ---------------------------------------------------------------------- */
QCheckBox {
    color: #333333;
}

/* 复选框指示器 (未选中状态) */
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #ced4da; /* 灰色边框 */
    border-radius: 3px;
    background-color: white;
}

/* 鼠标悬停在复选框上 */
QCheckBox::indicator:hover {
    border-color: #007bff; /* 悬停时边框变蓝 */
}

/* 复选框指示器 (选中状态) */
QCheckBox::indicator:checked {
    background-color: #007bff; /* 蓝色背景 */
    border-color: #007bff;

}

/* ---------------------------------------------------------------------- */
/* 3. 下拉框 (QComboBox) 样式 */
/* ---------------------------------------------------------------------- */
QComboBox {
    background-color: white;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 3px 5px;
    color: #333333;
}

/* 获得焦点时：边框高亮为主题色 */
QComboBox:focus {
    border-color: #007bff;
}

/* 下拉箭头按钮样式 */
/* QComboBox::drop-down {

    width: 20px;
