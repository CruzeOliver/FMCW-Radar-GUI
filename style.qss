/* 设置整个窗口的背景颜色 */
QWidget {
    background-color: #f0f0f0;  /* 浅灰色背景 */
    font-family: "Microsoft YaHei", SimSun;
    font-size: 9pt;
}

/* 设置所有 QPushButton 的样式 */
QPushButton {
    background-color: #4A90E2;        /* 蓝色背景 */
    color: white;                     /* 白色文字 */
    border: none;                     /* 无边框 */
    padding: 8px 16px;                /* 内边距 */
    border-radius: 6px;               /* 圆角 */
}

/* 鼠标悬停时的效果 */
QPushButton:hover {
    background-color: #357ABD;
}

/* 按下时的效果 */
QPushButton:pressed {
    background-color: #2C5AA0;
}

/* 如果你也有 QToolButton，也可以一并设置 */
QToolButton {
    background-color: #4A90E2;
    color: white;
    border: none;
    padding: 8px;
    border-radius: 6px;
}