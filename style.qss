    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
} */

/* 下拉箭头图标样式 */
QComboBox::down-arrow {

    width: 12px;
    height: 12px;
}

/* 列表视图（下拉菜单本身） */
QComboBox QAbstractItemView {
    border: 1px solid #007bff; /* 列表边框使用主题色 */
    outline: none; /* 移除焦点虚线 */
    padding: 4px 0;
}